{
  "name": "noondealsnow-ai-scheduler-v2",
  "main": "rpc-entry.mjs",
  "compatibility_date": "2026-11-01",
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "SITE_ID": "noondealsnow"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT_FINAL",
      "bucket_name": "nooncoupons-content-v2"
    }
  ]
}
