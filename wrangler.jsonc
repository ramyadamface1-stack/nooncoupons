{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nooncoupons",
  "main": "auto-platform.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "minify": true,
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "SITE_ORIGIN": "https://nooncoupons.ramychatgptgcoupons.workers.dev",
    "SITE_NAME": "كوبونات نون",
    "DEFAULT_LANGUAGE": "ar",
    "DEFAULT_COUNTRY": "SA",
    "AI_PRIMARY_PROVIDER": "gemini",
    "AI_FALLBACK_PROVIDER": "grok",
    "GEMINI_MODEL": "gemini-3.5-flash",
    "GROK_MODEL": "grok-4.3",
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "QUALITY_PUBLISH_THRESHOLD": "95",
    "MIN_ARTICLE_WORDS": "1000",
    "TARGET_ARTICLE_WORDS": "2000",
    "AUTO_REPAIR_ROUNDS": "2",
    "INDEXNOW_ENABLED": "false"
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "CONTENT_FINAL",
      "bucket_name": "nooncoupons-content-v2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTROL",
        "class_name": "ControlPlane"
      },
      {
        "name": "GENERATOR_CONTROL",
        "class_name": "GeneratorControl"
      }
    ]
  },
  "migrations": [
    {
      "tag": "platform-v1",
      "new_sqlite_classes": [
        "ControlPlane"
      ]
    },
    {
      "tag": "generator-v1",
      "new_sqlite_classes": [
        "GeneratorControl"
      ]
    }
  ]
}
