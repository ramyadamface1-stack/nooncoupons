{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nooncoupons",
  "main": "auto-platform.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "minify": true,
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "SITE_ORIGIN": "https://nooncoupons.ramychatgptgcoupons.workers.dev",
    "SITE_NAME": "كوبونات نون",
    "DEFAULT_LANGUAGE": "ar",
    "DEFAULT_COUNTRY": "SA",
    "AI_PRIMARY_PROVIDER": "workers-ai",
    "WORKERS_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "WORKERS_AI_FALLBACK_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "WORKERS_AI_DAILY_CAP": "60",
    "WORKERS_AI_DAILY_CALL_CAP": "80",
    "BULK_DAILY_TARGET": "2000",
    "BULK_BATCH_SIZE": "2",
    "QUALITY_PUBLISH_THRESHOLD": "95",
    "MIN_ARTICLE_WORDS": "1000",
    "TARGET_ARTICLE_WORDS": "1500",
    "AUTO_REPAIR_ROUNDS": "1",
    "INDEXNOW_ENABLED": "false"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "CONTENT_FINAL",
      "bucket_name": "nooncoupons-content-v2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTROL",
        "class_name": "ControlPlane"
      },
      {
        "name": "GENERATOR_CONTROL",
        "class_name": "GeneratorControl"
      }
    ]
  },
  "migrations": [
    {
      "tag": "platform-v1",
      "new_sqlite_classes": [
        "ControlPlane"
      ]
    },
    {
      "tag": "generator-v1",
      "new_sqlite_classes": [
        "GeneratorControl"
      ]
    }
  ]
}
