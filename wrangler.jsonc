{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nooncoupons",
  "main": "discovery-entry.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "minify": true,
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "SITE_ORIGIN": "https://noondealsnow.com",
    "SITE_NAME": "كوبونات نون",
    "DEFAULT_LANGUAGE": "ar",
    "DEFAULT_COUNTRY": "SA",
    "AI_PRIMARY_PROVIDER": "workers-ai",
    "WORKERS_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "WORKERS_AI_FALLBACK_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "WORKERS_AI_DAILY_CAP": "60",
    "WORKERS_AI_DAILY_CALL_CAP": "80",
    "BULK_DAILY_TARGET": "32000",
    "BULK_BATCH_SIZE": "16",
    "BULK_CATCHUP_TOTAL": "30000",
    "BULK_CATCHUP_BATCH_SIZE": "64",
    "BULK_CATCHUP_MIN_BATCH_SIZE": "32",
    "BULK_CATCHUP_TARGET_BATCH_MS": "52000",
    "BULK_CANDIDATE_BUDGET_MS": "42000",
    "BULK_CATCHUP_WINDOW_HOURS": "8",
    "LEGACY_UPGRADE_BATCH_SIZE": "4",
    "QUALITY_PUBLISH_THRESHOLD": "95",
    "MIN_ARTICLE_WORDS": "1500",
    "TARGET_ARTICLE_WORDS": "1500",
    "ENGLISH_CANARY_TOTAL": "2",
    "ENGLISH_CONTROLLED_TOTAL": "200",
    "ENGLISH_DAILY_TARGET": "24",
    "ENGLISH_MIN_INTERVAL_MINUTES": "60",
    "AUTO_REPAIR_ROUNDS": "1",
    "INDEXNOW_ENABLED": "true",
    "INDEXNOW_KEY": "8a3c907d7cbe7404c97aba32ed3fc7c9"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "CONTENT_FINAL",
      "bucket_name": "nooncoupons-content-v2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTROL",
        "class_name": "ControlPlane"
      },
      {
        "name": "GENERATOR_CONTROL",
        "class_name": "GeneratorControl"
      }
    ]
  },
  "migrations": [
    {
      "tag": "platform-v1",
      "new_sqlite_classes": [
        "ControlPlane"
      ]
    },
    {
      "tag": "generator-v1",
      "new_sqlite_classes": [
        "GeneratorControl"
      ]
    }
  ]
}
// e2e-audit-trigger: discovery-entry-v1-2026-09-17
